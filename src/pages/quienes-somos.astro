---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";

const quienesSomos = await getEntry("pages", "quienes-somos");

if (!quienesSomos) {
  throw new Error("No existe src/content/pages/quienes-somos.md");
}

const { Content } = await quienesSomos.render();
---

<BaseLayout title={`${quienesSomos.data.title} | UEM Capulí Loma`}>
  <div class="mx-auto max-w-4xl px-4 py-14">
    <h1 class="text-3xl font-bold">{quienesSomos.data.title}</h1>
    {quienesSomos.data.description && (
      <p class="mt-3 text-slate-600">{quienesSomos.data.description}</p>
    )}
    <article class="prose prose-slate mt-8 max-w-none">
      <Content />
    </article>
  </div>
</BaseLayout>
