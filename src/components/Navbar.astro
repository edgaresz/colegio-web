---
const links = [
  { href: "/", label: "Inicio" },
  { href: "/quienes-somos", label: "Conócenos" },
  { href: "/mision-vision", label: "Misión y Visión" },
  { href: "/noticias", label: "Noticias" },
  { href: "/galeria", label: "Galería" },
  { href: "/contacto", label: "Contacto" },
];
---

<header class="fixed top-0 z-50 w-full border-b border-[#F6D77A]/60 bg-[#EAF4FF]/80 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
    <a href="/" class="flex items-center gap-2 font-semibold">
      <img
        src="/uploads/logo.png"
        alt="Logo UEM Capulí Loma"
        class="h-10 w-10 object-contain"
      />
      <span class="hidden sm:inline text-slate-900">Unidad Educativa Municipal Capulí Loma</span>
      <span class="sm:hidden text-slate-900">UEMCL</span>
    </a>

    <nav class="hidden md:flex items-center gap-6 text-sm">
      {links.map((l) => (
        <a href={l.href} class="text-slate-700 hover:text-slate-900 transition-colors">
          {l.label}
        </a>
      ))}
    </nav>

    <a
      href="/contacto"
      class="hidden md:inline-flex rounded-xl bg-[#7FB6E8] px-4 py-2 text-sm text-white hover:brightness-95 transition shadow-sm"
    >
      Contáctanos
    </a>

    <a
      href="/contacto"
      class="md:hidden rounded-xl bg-[#7FB6E8] px-3 py-2 text-sm text-white hover:brightness-95 transition shadow-sm"
    >
      Contacto
    </a>
  </div>
</header>