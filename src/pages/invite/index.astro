---
const SITE = "https://splendid-valkyrie-a538a6.netlify.app";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Activar cuenta</title>

    <!-- Identity widget -->
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  </head>

  <body style="font-family: system-ui; padding: 48px;">
    <h1>Activar cuenta</h1>
    <p>Si no se abre el formulario automáticamente, espera 2–3 segundos.</p>
    <p id="status" style="opacity:.7;">Preparando registro…</p>

    <script>
    (function () {
        const statusEl = document.getElementById("status");

        function setStatus(t: string) {
        if (statusEl) statusEl.textContent = t;
        }

        function getInviteToken() {
        const hash = window.location.hash || "";
        const m = hash.match(/invite_token=([^&]+)/);
        return m ? decodeURIComponent(m[1]) : null;
        }

        function boot() {
        const token = getInviteToken();
        if (!token) {
            setStatus("No se encontró invite_token en la URL.");
            return;
        }

        const identity = window.netlifyIdentity;
        if (!identity) {
            setStatus("No cargó Netlify Identity (revisa bloqueadores / consola).");
            return;
        }

        setStatus("Abriendo formulario…");

        identity.on("init", () => {
            identity.open("signup");
        });

        identity.on("signup", () => {
            window.location.href = "/admin/";
        });

        identity.on("login", () => {
            window.location.href = "/admin/";
        });

        identity.init();

        setTimeout(() => {
            try {
            identity.open("signup");
            } catch (e) {}
        }, 1500);
        }

        setTimeout(boot, 200);
    })();
    </script>
  </body>
</html>