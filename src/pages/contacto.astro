---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";

const contacto = await getEntry("pages", "contacto");

if (!contacto) {
  throw new Error("No existe src/content/pages/contacto.md");
}

const { Content } = await contacto.render();
---

<BaseLayout title={`${contacto.data.title} | UEM Capulí Loma`}>
  <div class="mx-auto max-w-4xl px-4 py-14">
    <h1 class="text-3xl font-bold">{contacto.data.title}</h1>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-[#7FB6E8]/25 bg-white p-6">
        {contacto.data.address && (
          <p class="text-slate-700">
            <span class="font-semibold">Dirección:</span> {contacto.data.address}
          </p>
        )}
        {contacto.data.phone && (
          <p class="mt-3 text-slate-700">
            <span class="font-semibold">Teléfono:</span> {contacto.data.phone}
          </p>
        )}
        {contacto.data.email && (
          <p class="mt-3 text-slate-700">
            <span class="font-semibold">Correo:</span> {contacto.data.email}
          </p>
        )}
      </div>

      {contacto.data.mapEmbedUrl && (
        <iframe
          src={contacto.data.mapEmbedUrl}
          title="Mapa de ubicación"
          class="h-64 w-full rounded-2xl border border-[#7FB6E8]/25"
          loading="lazy"
          referrerPolicy="no-referrer-when-downgrade"
        />
      )}
    </div>

    <article class="prose prose-slate mt-8 max-w-none">
      <Content />
    </article>
  </div>
</BaseLayout>
