---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Activar cuenta | Panel">
  <section style="max-width: 720px; margin: 0 auto; padding: 48px 16px;">
    <h1 style="font-size: 28px; font-weight: 700;">Activar cuenta</h1>
    <p style="margin-top: 12px; color: #475569;">
      Si no se abre el formulario automáticamente, espera 2–3 segundos.
    </p>

    <div id="invite-status" style="margin-top: 18px; color:#64748b;">
      Preparando registro...
    </div>

    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script is:inline>
      (function () {
        const statusEl = document.getElementById("invite-status");
        const hash = window.location.hash || "";
        const hasInvite = /invite_token=/.test(hash);
        const hasConfirmation = /confirmation_token=/.test(hash);
        const hasRecovery = /recovery_token=/.test(hash);
        const hasAnyToken = hasInvite || hasConfirmation || hasRecovery;

        function setStatus(message) {
          if (statusEl) statusEl.textContent = message;
        }

        function tryOpenWidget(identity) {
          try {
            if (hasInvite) {
              identity.open("signup");
              setStatus("Abriendo formulario para crear contraseña...");
              return;
            }

            identity.open("login");
            if (hasConfirmation) {
              setStatus("Correo confirmado. Inicia sesión para entrar al panel.");
              return;
            }

            if (hasRecovery) {
              setStatus("Abriendo recuperación de cuenta...");
              return;
            }

            setStatus("Abriendo formulario...");
          } catch {
            setStatus("No se pudo abrir el formulario automáticamente.");
          }
        }

        function start(identity) {
          identity.on("init", (user) => {
            if (!hasAnyToken) {
              setStatus("No se encontró token en la URL.");
              return;
            }

            // Si ya hay sesión activa, forzamos logout para mostrar signup.
            if (hasInvite && user) {
              identity.logout();
            }

            tryOpenWidget(identity);
          });

          identity.on("signup", () => {
            window.location.href = "/admin/";
          });

          identity.on("login", () => {
            window.location.href = "/admin/";
          });

          identity.init();
          setTimeout(() => {
            if (!hasAnyToken) return;
            tryOpenWidget(identity);
          }, 1500);
        }

        const waitForIdentity = setInterval(() => {
          if (!window.netlifyIdentity) return;
          clearInterval(waitForIdentity);
          start(window.netlifyIdentity);
        }, 150);

        setTimeout(() => {
          clearInterval(waitForIdentity);
          if (!window.netlifyIdentity) {
            setStatus("No cargó Netlify Identity. Revisa bloqueadores o consola.");
          }
        }, 8000);
      })();
    </script>
  </section>
</BaseLayout>
