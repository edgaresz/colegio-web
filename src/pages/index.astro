---
import BaseLayout from "../layouts/BaseLayout.astro";
import GalleryCarousel3D from "../components/GalleryCarousel3D";

---

<BaseLayout title="Inicio | Unidad Educativa Municipal Capulí Loma">

  <!-- HERO -->
  <section class="bg-gradient-to-b from-[#EAF4FF] via-white to-[#FFF6DB]">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="inline-flex rounded-full border border-[#F6D77A]/60 bg-white/80 px-3 py-1 text-xs text-slate-700 backdrop-blur">
            Institución educativa municipal
          </p>

          <h1 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl text-slate-900">
            Unidad Educativa Municipal Capulí Loma
          </h1>

          <p class="mt-4 text-lg text-slate-600">
            Excelencia académica con valores para nuestra comunidad.
          </p>

          <div class="mt-7 flex flex-wrap gap-3">
            <a
              href="/quienes-somos"
              class="rounded-xl bg-[#7FB6E8] px-5 py-3 text-sm font-medium text-white hover:brightness-95 transition shadow-sm"
            >
              Conócenos
            </a>

            <a
              href="/contacto"
              class="rounded-xl border border-[#7FB6E8]/40 bg-white/70 px-5 py-3 text-sm font-medium text-slate-900 hover:bg-white transition"
            >
              Contacto
            </a>
          </div>

          <div class="mt-8 grid grid-cols-2 gap-4 sm:flex sm:gap-6 text-sm text-slate-600">
            <div class="rounded-2xl bg-white/70 border border-[#F6D77A]/40 px-3 py-2">
              <span class="font-semibold text-slate-900">120</span> estudiantes
            </div>
            <div class="rounded-2xl bg-white/70 border border-[#F6D77A]/40 px-3 py-2">
              <span class="font-semibold text-slate-900">12</span> docentes
            </div>
            <div class="rounded-2xl bg-white/70 border border-[#F6D77A]/40 px-3 py-2">
              <span class="font-semibold text-slate-900">2001</span> creación
            </div>
            <div class="rounded-2xl bg-white/70 border border-[#F6D77A]/40 px-3 py-2">
              <span class="font-semibold text-slate-900">Inicial–7º</span> EGB
            </div>
          </div>
        </div>

        <!-- Imagen mock -->
        <div class="relative">
          <div class="aspect-[16/11] w-full overflow-hidden rounded-3xl border border-[#7FB6E8]/25 bg-white/60 shadow-sm">
            <img
              src="/uploads/colegio-principal.jpg"
              alt="Imagen del colegio"
              class="h-full w-full object-cover"
            />
          </div>

          <!-- detalle decorativo suave -->
          <div class="pointer-events-none absolute -bottom-5 -left-5 hidden sm:block h-20 w-20 rounded-3xl bg-[#FFE9DC]/70" />
        </div>
      </div>
    </div>
  </section>

  <!-- PRINCIPIOS -->
  <section>
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h2 class="text-2xl font-bold text-slate-900">Principios educativos</h2>
      <p class="mt-2 text-slate-600">Bases que guían nuestra formación integral.</p>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { t: "Equidad", d: "Oportunidades para todos." },
          { t: "Inclusión", d: "Respeto a la diversidad." },
          { t: "Participación", d: "Comunidad educativa activa." },
          { t: "Calidad", d: "Mejora continua del aprendizaje." },
          { t: "Innovación", d: "Metodologías y recursos actuales." },
          { t: "Respeto al entorno", d: "Cuidado del ambiente y convivencia." },
        ].map((p, idx) => (
          <div class="rounded-2xl border border-[#7FB6E8]/20 bg-white p-5 hover:shadow-sm transition">
            <div class="flex items-start gap-3">
              <div
                class={`mt-0.5 h-9 w-9 rounded-xl grid place-items-center border
                  ${idx % 3 === 0 ? "bg-[#FFF6DB] border-[#F6D77A]/60" : ""}
                  ${idx % 3 === 1 ? "bg-[#EAF4FF] border-[#7FB6E8]/35" : ""}
                  ${idx % 3 === 2 ? "bg-[#FFE9DC] border-[#F4A777]/35" : ""}
                `}
              >
                <span class="text-slate-700 text-sm">★</span>
              </div>
              <div>
                <p class="font-semibold text-slate-900">{p.t}</p>
                <p class="mt-1 text-sm text-slate-600">{p.d}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MISION / VISION -->
  <section class="bg-[#EAF4FF]/60">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <div class="grid gap-6 lg:grid-cols-2">
        <div class="rounded-3xl border border-[#7FB6E8]/20 bg-white p-7 shadow-sm">
          <p class="inline-flex rounded-full bg-[#FFF6DB] px-3 py-1 text-xs text-slate-700 border border-[#F6D77A]/60">
            Identidad institucional
          </p>
          <h3 class="mt-3 text-xl font-bold text-slate-900">Misión</h3>
          <p class="mt-3 text-slate-600">
            (Texto de misión aquí — por ahora mock. Luego lo conectamos a tu .md)
          </p>
        </div>

        <div class="rounded-3xl border border-[#7FB6E8]/20 bg-white p-7 shadow-sm">
          <p class="inline-flex rounded-full bg-[#FFE9DC] px-3 py-1 text-xs text-slate-700 border border-[#F4A777]/40">
            Proyección
          </p>
          <h3 class="mt-3 text-xl font-bold text-slate-900">Visión</h3>
          <p class="mt-3 text-slate-600">
            (Texto de visión aquí — por ahora mock. Luego lo conectamos a tu .md)
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- NOTICIAS (mock) -->
  <section>
    <div class="mx-auto max-w-6xl px-4 py-14">
      <div class="flex items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl font-bold text-slate-900">Últimas noticias</h2>
          <p class="mt-2 text-slate-600">Comunicados, eventos y actividades.</p>
        </div>
        <a href="/noticias" class="text-sm font-medium text-[#7FB6E8] hover:underline">
          Ver todas
        </a>
      </div>

      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {[1, 2, 3].map((i) => (
          <a
            href="/noticias"
            class="group overflow-hidden rounded-3xl border border-[#7FB6E8]/20 bg-white hover:shadow-sm transition"
          >
            <div class="aspect-[16/10] bg-[#EAF4FF]/70">
              <img
                src={`/uploads/news-${i}.jpg`}
                alt=""
                class="h-full w-full object-cover group-hover:scale-[1.02] transition"
              />
            </div>
            <div class="p-5">
              <p class="text-xs text-slate-500">Feb 2026</p>
              <p class="mt-2 font-semibold text-slate-900">Noticia de ejemplo #{i}</p>
              <p class="mt-2 text-sm text-slate-600">
                Resumen corto de la noticia para mostrar el diseño.
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- GALERIA (mock) -->
  <section class="bg-[#FFF6DB]/50">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <div class="flex items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl font-bold text-slate-900">Galería</h2>
          <p class="mt-2 text-slate-600">Momentos y actividades de nuestra comunidad.</p>
        </div>
        <a href="/galeria" class="text-sm font-medium text-[#7FB6E8] hover:underline">Ver galería</a>
      </div>

      {/* CONTENEDOR DEL CARRUSEL (separado y con altura) */}
      <div class="mt-8 rounded-3xl border border-[#F4A777]/15 bg-white/30 px-3 py-6 sm:px-6">
        <GalleryCarousel3D
          client:load
          images={[
            "/uploads/g-1.jpg",
            "/uploads/g-2.jpg",
            "/uploads/g-3.jpg",
            "/uploads/g-4.jpg",
            "/uploads/g-5.jpg",
            "/uploads/g-6.jpg",
          ]}
        />
      </div>
    </div>
  </section>
</BaseLayout>