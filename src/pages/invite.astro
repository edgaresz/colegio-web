---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Activar cuenta | Panel">
  <section style="max-width: 720px; margin: 0 auto; padding: 48px 16px;">
    <h1 style="font-size: 28px; font-weight: 700;">Activar cuenta</h1>
    <p style="margin-top: 12px; color: #475569;">
      Si no se abre el formulario automáticamente, espera 2–3 segundos.
    </p>

    <div id="invite-status" style="margin-top: 18px; color:#64748b;">
      Preparando registro...
    </div>

    <script is:inline>
      (function () {
        const hasInvite = window.location.hash.includes("invite_token=");

        function openInvite() {
          const netlifyIdentity = window.netlifyIdentity;
          if (!netlifyIdentity) return;

          netlifyIdentity.init();

          netlifyIdentity.on("init", (user) => {
            // Si ya hay sesión, primero cerrar sesión para que aparezca signup
            if (user) {
              netlifyIdentity.logout();
            }
            if (hasInvite) {
              netlifyIdentity.open("signup");
              const el = document.getElementById("invite-status");
              if (el) el.textContent = "Abriendo formulario para crear contraseña...";
            }
          });

          netlifyIdentity.on("signup", () => {
            window.location.href = "/admin/";
          });

          netlifyIdentity.on("login", () => {
            window.location.href = "/admin/";
          });
        }

        // Espera a que cargue el widget
        const t = setInterval(() => {
          if (window.netlifyIdentity) {
            clearInterval(t);
            openInvite();
          }
        }, 200);

        setTimeout(() => clearInterval(t), 8000);
      })();
    </script>
  </section>
</BaseLayout>