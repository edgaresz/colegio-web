---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";

const missionVision = await getEntry("pages", "mision-vision");

if (!missionVision) {
  throw new Error("No existe src/content/pages/mision-vision.md");
}

const missionText = missionVision.data.mission ?? "Agrega la misión desde el panel admin.";
const visionText = missionVision.data.vision ?? "Agrega la visión desde el panel admin.";
---

<BaseLayout title={`${missionVision.data.title} | UEM Capulí Loma`}>
  <div class="mx-auto max-w-4xl px-4 py-14">
    <h1 class="text-3xl font-bold">{missionVision.data.title}</h1>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <article class="rounded-2xl border border-[#7FB6E8]/25 bg-white p-6">
        <h2 class="text-xl font-semibold text-slate-900">Misión</h2>
        <p class="mt-3 text-slate-700">{missionText}</p>
      </article>
      <article class="rounded-2xl border border-[#7FB6E8]/25 bg-white p-6">
        <h2 class="text-xl font-semibold text-slate-900">Visión</h2>
        <p class="mt-3 text-slate-700">{visionText}</p>
      </article>
    </div>
  </div>
</BaseLayout>
