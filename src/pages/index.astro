---
import BaseLayout from "../layouts/BaseLayout.astro";
import GalleryCarousel3D from "../components/GalleryCarousel3D";
import { getCollection, getEntry } from "astro:content";

const missionVision = await getEntry("pages", "mision-vision");
const latestNews = (await getCollection("news"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const galleryEntries = (await getCollection("gallery")).sort((a, b) => {
  const aTime = a.data.date ? a.data.date.getTime() : 0;
  const bTime = b.data.date ? b.data.date.getTime() : 0;
  return bTime - aTime;
});

const carouselImages = galleryEntries
  .flatMap((entry) => entry.data.images.map((item) => item.image))
  .slice(0, 8);

const newsDateFormatter = new Intl.DateTimeFormat("es-EC", {
  day: "2-digit",
  month: "short",
  year: "numeric",
});

function getNewsSummary(entry: (typeof latestNews)[number]) {
  if (entry.data.excerpt) return entry.data.excerpt;
  const text = entry.body.replace(/\s+/g, " ").trim();
  if (!text) return "";
  return text.length > 120 ? `${text.slice(0, 117)}...` : text;
}

const missionText = missionVision?.data.mission ?? "Edita la misión desde el panel admin.";
const visionText = missionVision?.data.vision ?? "Edita la visión desde el panel admin.";
---

<BaseLayout title="Inicio | Unidad Educativa Municipal Capulí Loma">
  <section class="bg-gradient-to-b from-[#EAF4FF] via-white to-[#FFF6DB]">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="inline-flex rounded-full border border-[#F6D77A]/60 bg-white/80 px-3 py-1 text-xs text-slate-700 backdrop-blur">
            Institución educativa municipal
          </p>

          <h1 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl text-slate-900">
            Unidad Educativa Municipal Capulí Loma
          </h1>

          <p class="mt-4 text-lg text-slate-600">
            Excelencia académica con valores para nuestra comunidad.
          </p>

          <div class="mt-7 flex flex-wrap gap-3">
            <a
              href="/quienes-somos"
              class="rounded-xl bg-[#7FB6E8] px-5 py-3 text-sm font-medium text-white transition hover:brightness-95"
            >
              Conócenos
            </a>

            <a
              href="/contacto"
              class="rounded-xl border border-[#7FB6E8]/40 bg-white/70 px-5 py-3 text-sm font-medium text-slate-900 transition hover:bg-white"
            >
              Contacto
            </a>
          </div>
        </div>

        <div class="relative">
          <div class="aspect-[16/11] w-full overflow-hidden rounded-3xl border border-[#7FB6E8]/25 bg-white/60 shadow-sm">
            <img
              src="/uploads/colegio-principal.jpg"
              alt="Imagen del colegio"
              class="h-full w-full object-cover"
            />
          </div>

          <div class="pointer-events-none absolute -bottom-5 -left-5 hidden h-20 w-20 rounded-3xl bg-[#FFE9DC]/70 sm:block" />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#EAF4FF]/60">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <div class="grid gap-6 lg:grid-cols-2">
        <div class="rounded-3xl border border-[#7FB6E8]/20 bg-white p-7 shadow-sm">
          <p class="inline-flex rounded-full border border-[#F6D77A]/60 bg-[#FFF6DB] px-3 py-1 text-xs text-slate-700">
            Identidad institucional
          </p>
          <h3 class="mt-3 text-xl font-bold text-slate-900">Misión</h3>
          <p class="mt-3 text-slate-600">{missionText}</p>
        </div>

        <div class="rounded-3xl border border-[#7FB6E8]/20 bg-white p-7 shadow-sm">
          <p class="inline-flex rounded-full border border-[#F4A777]/40 bg-[#FFE9DC] px-3 py-1 text-xs text-slate-700">
            Proyección
          </p>
          <h3 class="mt-3 text-xl font-bold text-slate-900">Visión</h3>
          <p class="mt-3 text-slate-600">{visionText}</p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-6xl px-4 py-14">
      <div class="flex items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl font-bold text-slate-900">Últimas noticias</h2>
          <p class="mt-2 text-slate-600">Comunicados, eventos y actividades.</p>
        </div>
        <a href="/noticias" class="text-sm font-medium text-[#7FB6E8] hover:underline">Ver todas</a>
      </div>

      {latestNews.length === 0 ? (
        <p class="mt-6 text-slate-600">Aún no hay noticias publicadas.</p>
      ) : (
        <div class="mt-8 grid gap-6 md:grid-cols-3">
          {latestNews.map((entry) => (
            <article class="overflow-hidden rounded-3xl border border-[#7FB6E8]/20 bg-white">
              {entry.data.cover && (
                <img
                  src={entry.data.cover}
                  alt={entry.data.title}
                  class="aspect-[16/10] w-full object-cover"
                  loading="lazy"
                />
              )}
              <div class="p-5">
                <p class="text-xs text-slate-500">{newsDateFormatter.format(entry.data.date)}</p>
                <p class="mt-2 font-semibold text-slate-900">{entry.data.title}</p>
                {getNewsSummary(entry) && (
                  <p class="mt-2 text-sm text-slate-600">{getNewsSummary(entry)}</p>
                )}
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="bg-[#FFF6DB]/50">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <div class="flex items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl font-bold text-slate-900">Galería</h2>
          <p class="mt-2 text-slate-600">Momentos y actividades de nuestra comunidad.</p>
        </div>
        <a href="/galeria" class="text-sm font-medium text-[#7FB6E8] hover:underline">Ver galería</a>
      </div>

      <div class="mt-8 rounded-3xl border border-[#F4A777]/15 bg-white/30 px-3 py-6 sm:px-6">
        {carouselImages.length > 0 ? (
          <GalleryCarousel3D client:load images={carouselImages} />
        ) : (
          <p class="text-center text-slate-600">Aún no hay imágenes en la galería.</p>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
